#
# Native macOS build for the original Quake software renderer.
#
# Cocoa presents the 8-bit framebuffer and supplies keyboard and mouse events.
# Core Audio plays the output from Quake's original software mixer.
#

CC              ?= clang
BUILD_ROOT      ?= build/macos
CONFIG          ?= release
BUILD_DIR        = $(BUILD_ROOT)/$(CONFIG)
TARGET           = $(BUILD_DIR)/quake

COMMON_CFLAGS    = -std=gnu89 -fcommon -Dstricmp=strcasecmp \
	-Dstrnicmp=strncasecmp -include strings.h \
	-Wno-deprecated-declarations
release_CFLAGS   = -O2
debug_CFLAGS     = -O0 -g
CFLAGS           := $(COMMON_CFLAGS) $($(CONFIG)_CFLAGS) $(CFLAGS)
OBJCFLAGS        := $(CFLAGS) -fobjc-arc $(OBJCFLAGS)
unexport CFLAGS OBJCFLAGS
LDLIBS            = -framework Cocoa -framework CoreGraphics -framework CoreVideo \
	-framework AudioUnit -framework AudioToolbox -framework CoreAudio -framework QuartzCore -lm

SOURCES = \
	cl_demo.c cl_input.c cl_main.c cl_parse.c cl_tent.c chase.c \
	cmd.c common.c console.c crc.c cvar.c draw.c \
	d_edge.c d_fill.c d_init.c d_modech.c d_part.c d_polyse.c \
	d_scan.c d_sky.c d_sprite.c d_surf.c d_vars.c d_zpoint.c \
	host.c host_cmd.c keys.c menu.c mathlib.c model.c \
	net_dgrm.c net_loop.c net_main.c net_vcr.c net_udp.c net_bsd.c \
	nonintel.c pr_cmds.c pr_edict.c pr_exec.c \
	r_aclip.c r_alias.c r_bsp.c r_light.c r_draw.c r_efrag.c \
	r_edge.c r_misc.c r_main.c r_sky.c r_sprite.c r_surf.c \
	r_part.c r_vars.c screen.c sbar.c \
	sv_main.c sv_phys.c sv_move.c sv_user.c zone.c view.c wad.c world.c \
	cd_null.c snd_dma.c snd_mem.c snd_mix.c snd_macos.c sys_linux.c

OBJECTS = $(SOURCES:%.c=$(BUILD_DIR)/%.o) $(BUILD_DIR)/vid_macos.o
DEPS    = $(OBJECTS:.o=.d)

.PHONY: all release debug clean run

all: release

release:
	$(MAKE) -f Makefile.macos CONFIG=release $(BUILD_ROOT)/release/quake

debug:
	$(MAKE) -f Makefile.macos CONFIG=debug $(BUILD_ROOT)/debug/quake

$(TARGET): $(OBJECTS)
	$(CC) $(OBJECTS) -o $@ $(LDLIBS)

$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD_DIR)/vid_macos.o: vid_macos.m
	@mkdir -p $(dir $@)
	$(CC) $(OBJCFLAGS) -MMD -MP -c $< -o $@

run: release
	cd .. && WinQuake/$(BUILD_ROOT)/release/quake

clean:
	rm -rf $(BUILD_ROOT)

-include $(DEPS)
