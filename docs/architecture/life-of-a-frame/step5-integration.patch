 <script>
 {{BASE_JS}}
+// Reveal only changes the view; both complete images remain available without JS.
+document.querySelectorAll(".capture-pair").forEach(function (figure) {
+  var control = figure.querySelector(".capture-control");
+  var slider = control.querySelector("input");
+  var output = control.querySelector("output");
+  function reveal() {
+    figure.style.setProperty("--reveal", slider.value + "%");
+    output.value = slider.value + "%";
+    slider.setAttribute("aria-valuetext", slider.value + "% changed image");
+  }
+  figure.classList.add("is-interactive");
+  control.hidden = false;
+  slider.addEventListener("input", reveal);
+  reveal();
+});
 </script>
 
